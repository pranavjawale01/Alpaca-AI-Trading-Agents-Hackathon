# ─────────────────────────────────────────────────────────────
#  Cache Me — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# Alpaca Paper Trading credentials (https://alpaca.markets)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper trading endpoint

# Featherless AI (OpenAI-compatible, https://featherless.ai)
FEATHERLESS_API_KEY=your_featherless_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Llama-3.1-8B-Instruct  # default model

# Risk parameters (can override defaults in config.py)
MAX_POSITION_PCT=0.05        # 5% of account per position
MAX_OPTIONS_EXPOSURE_PCT=0.30 # 30% of account in options
DAILY_LOSS_LIMIT_PCT=0.02    # halt if daily P&L < -2%
VIX_KILL_SWITCH=35           # halt all new orders above this VIX

# Paper account starting balance (must be $100,000 for hackathon judging)
ACCOUNT_STARTING_BALANCE=100000

# Logging
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
