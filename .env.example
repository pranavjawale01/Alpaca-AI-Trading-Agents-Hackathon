# ─────────────────────────────────────────────────────────────
#  Cache Me — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# Alpaca Paper Trading credentials (https://alpaca.markets)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper trading endpoint

# Featherless AI (OpenAI-compatible, https://featherless.ai)
FEATHERLESS_API_KEY=your_featherless_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Llama-3.1-8B-Instruct  # default model

# Risk parameters (can override defaults in config.py)
MAX_POSITION_PCT=0.05        # 5% of account per position
MAX_OPTIONS_EXPOSURE_PCT=0.30 # 30% of account in options
DAILY_LOSS_LIMIT_PCT=0.02    # halt if daily P&L < -2%
VIX_KILL_SWITCH=35           # halt all new orders above this VIX

# Paper account starting balance (must be $100,000 for hackathon judging)
ACCOUNT_STARTING_BALANCE=100000

# Logging
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── LLM Council (3-Model Voting Ensemble) ──────────────────────
# Three models are queried in parallel for every trade signal.
# All must be accessible on your FEATHERLESS_API_KEY account.
# Set COUNCIL_ENABLED=false to bypass voting (pure rules-based).

COUNCIL_ENABLED=true

# Model 1 — Fast primary (same key used by MCPBridge)
COUNCIL_MODEL_1=meta-llama/Llama-3.1-8B-Instruct

# Model 2 — Contrarian check (different training distribution)
COUNCIL_MODEL_2=mistralai/Mistral-7B-Instruct-v0.3

# Model 3 — Chain-of-thought reasoner (edge-case accuracy)
COUNCIL_MODEL_3=deepseek-ai/DeepSeek-R1-Distill-Llama-8B

# Minimum |weighted score| to act on a signal (range: 0.0–1.0)
# 0.60 = two confident models override one uncertain model
COUNCIL_THRESHOLD=0.60

# Per-model timeout in seconds (models are queried in parallel)
COUNCIL_TIMEOUT=10.0

# ── Pro Trading Systems ─────────────────────────────────────────
# Smart Limit Order Execution — avoids paying full bid-ask spread
USE_LIMIT_ORDERS=true          # false = always use market orders
LIMIT_ORDER_TIMEOUT=30.0       # seconds to wait for limit fill
LIMIT_AGGRESSION_STEPS=3       # price steps before falling back to market

# Trailing Stop Loss (Momo calls)
# Exit when P&L pulls back this fraction from its peak (e.g., 0.25 = 25%)
TRAILING_STOP_PCT=0.25

# Kelly Criterion Position Sizing
KELLY_FRACTION=0.25            # quarter-Kelly (industry standard for live trading)
KELLY_MIN_TRADES=10            # min closed trades before Kelly is trusted

# Trade Journal (SQLite database path)
LOG_DB_PATH=logs/trading.db
